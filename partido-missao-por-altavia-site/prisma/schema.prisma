// Schema do banco de dados — Partido Missão por Altávia (PMA)
// República de Altávia — micronação lusófona soberana

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Notícias publicadas pelo partido
model NewsPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  summary     String
  content     String
  author      String
  featured    Boolean  @default(false)
  published   Boolean  @default(true) // publicada no site (false = rascunho)
  publishedAt DateTime
  createdAt   DateTime @default(now())
}

// Filiados do partido (formulário de filiação)
model Member {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  phone      String?
  city       String
  region     String
  birthYear  Int?
  motivation String?
  createdAt  DateTime @default(now())
}

// Mensagens recebidas pelo formulário de contato
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false) // lida pela administração
  createdAt DateTime @default(now())
}

// Candidaturas registradas pelo partido (gestão pelo administrador)
model Candidacy {
  id        String   @id @default(cuid())
  position  String // cargo disputado
  election  String // pleito
  candidate String // candidato
  slogan    String?
  proposal  String?
  status    String   @default("Anunciada") // Anunciada | Registrada | Em campanha
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Estatísticas institucionais exibidas na página inicial
model PartyStat {
  id      String  @id @default(cuid())
  key     String  @unique
  label   String
  value   Int
  suffix  String?
  order   Int
}
